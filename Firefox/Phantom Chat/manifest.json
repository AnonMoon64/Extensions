{
    "manifest_version": 2,
    "name": "PhantomChat",
    "version": "1.0",
    "description": "End to end encrypted chat using P2P and DHT",
    "permissions": ["activeTab", "webRequest", "webRequestBlocking", "storage", "<all_urls>"],
    "icons": {
      "16": "Icon/icon16.png",
      "48": "Icon/icon48.png",
      "128": "Icon/icon128.png"
    },
    "browser_action": {
      "default_popup": "popup.html"
    },
    "background": {
      "scripts": ["background.js"]
    },
    "options_ui": {
      "page": "options.html",
      "open_in_tab": true
    }
  }