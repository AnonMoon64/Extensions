{
    "manifest_version": 3,
    "name": "PhantomGuard",
    "version": "2.0",
    "description": "Blocks unwanted domains, trackers, and web elements for enhanced privacy.",
    "permissions": ["storage", "activeTab", "declarativeNetRequest", "scripting"],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["browser-polyfill.min.js", "removeElements.js", "contentScript.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["browser-polyfill.min.js"],
            "matches": ["<all_urls>"]
        }
    ]
}